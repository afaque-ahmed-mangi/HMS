# =============================================
# HMS Backend - Environment Variables
# Copy this file to .env and fill in values
# =============================================

# MongoDB Connection (required for production)
# Get a free cluster at: https://www.mongodb.com/atlas/database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hms?retryWrites=true&w=majority

# JWT Secret (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this

# AI Provider Configuration
AI_PROVIDER=external
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=your-gemini-api-key-here

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-vercel-app.vercel.app

# Server Port (not needed on Vercel)
PORT=5000
