PORT=5000
NODE_ENV=development
# Set MONGO_URI when deploying to production (e.g., MongoDB Atlas or local MongoDB)
# Leave empty for automatic development in-memory database
MONGO_URI=

# AI Chatbot Configuration
# AI_PROVIDER options:
# - "external" (or "gemini" / "claude"): calls external AI API using AI_API_KEY
# - "local": routes to your own trained local model in src/ai/localProvider.js
AI_PROVIDER=external
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-1.5-flash
