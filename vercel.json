{
  "version": 2,
  "builds": [
    {
      "src": "front-end/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "back-end/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "back-end/api/index.js" },
    { "src": "/api/(.*)",    "dest": "back-end/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "front-end/dist/index.html" }
  ]
}
